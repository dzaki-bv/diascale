{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "diascale-archive",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "vars": {
    "ALLOWED_ORIGINS": "capacitor://localhost,http://localhost,https://localhost,http://localhost:4173,http://127.0.0.1:4173",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diascale-archive",
      // Replace after creating D1 in the intended Cloudflare account, before deployment.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
