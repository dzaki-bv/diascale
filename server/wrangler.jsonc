{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "diascale-archive",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "vars": {
    "ALLOWED_ORIGINS": "capacitor://localhost,http://localhost,https://localhost,http://localhost:4173,http://127.0.0.1:4173",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diascale-archive",
      "database_id": "5163d2ec-963e-42a5-b521-37147102f85d",
      "migrations_dir": "migrations",
    },
  ],
}
